+            npt  = size(gab) + size(gba)
+            tobs = (sum(gab) + sum(gba)) / real(npt,dp)
+            gs   = sqrt((sum((gab - tobs)**2) + sum((gba - tobs)**2)) / real(max(npt - 1, 1),dp))
