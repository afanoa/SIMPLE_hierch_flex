+    subroutine holdout_gain( self, ifit, iscore, start, k, eps, neq, gain )
+        class(state_mergeup), intent(inout) :: self
+        integer,              intent(in)    :: ifit(:), iscore(:), start(:), k, neq
+        real,                 intent(in)    :: eps(0:)
+        real(dp), allocatable, intent(out)  :: gain(:)
+        complex,             allocatable :: m(:,:,:,:)
+        type(reconstructor), allocatable :: refs(:)
+        real,     allocatable :: w(:,:), wn(:,:), wp(:,:), w1(:,:)
+        real(dp), allocatable :: lpk(:), lp0(:)
+        integer,  allocatable :: mp(:)
+        logical,  allocatable :: l_alive(:)
+        real(dp) :: llb(2)
+        integer  :: it, g, i
+        allocate(w(size(ifit),k), source=0.)
+        do i = 1, size(ifit)
+            if( start(i) > 0 ) w(i,start(i)) = 1.
+        end do
+        allocate(l_alive(k), source=.true.)
+        allocate(m(self%nh,self%box,self%box,k+1), refs(k+1))
+        do g = 1, k+1
+            call refs(g)%new_accumulator(self%p, self%b%spproj, expand=.true., wthreads=.false.)
+        end do
+        do it = 0, self%nhit
+            call self%em_maps(ifit, w, eps, neq, .false., m)
+            ! the fit sees its own half only; no docking: each map stays in its particles' frame, which the scored half shares
+            !$omp parallel do default(shared) private(g) schedule(dynamic) proc_bind(close)
+            do g = 1, k+1
+                call refs(g)%set_ft(.true.)
+                call refs(g)%set_cmat(m(:,:,:,g))
+                call refs(g)%expand_exp
+            end do
+            !$omp end parallel do
+            if( it == self%nhit ) exit
+            call self%estep(ifit, w, refs(1:k), l_alive, wn)
+            w  = wn
+            mp = maxloc(w, dim=2)
+            do g = 1, k
+                if( l_alive(g) .and. count(mp == g) == 0 .and. count(l_alive) > 1 ) l_alive(g) = .false.
+            end do
+        end do
+        allocate(wp(size(iscore),k), w1(size(iscore),1), source=1.)
+        do g = 1, k
+            wp(:,g) = merge(sum(w(:,g)) / real(size(ifit)), 0., l_alive(g))
+        end do
+        call self%estep(iscore, wp, refs(1:k), l_alive, wn, kcut=self%klo, llband=llb, lpp=lpk)
+        call self%estep(iscore, w1, refs(k+1:k+1), [.true.], wn, kcut=self%klo, llband=llb, lpp=lp0)
+        gain = lpk - lp0
+        do g = 1, k+1
+            call refs(g)%kill
+        end do
+        deallocate(m, refs, w, wn, wp, w1, l_alive)
+    end subroutine holdout_gain
