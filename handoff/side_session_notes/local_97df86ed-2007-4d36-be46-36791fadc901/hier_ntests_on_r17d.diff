+    ! SIMPLE_SPLIT_HIER=yes: hierarchical Bonferroni, a node is tested at N_root / N_node tests (its children only after it splits)
+    integer function node_ntests( self, i )
+        class(hetero_tree), intent(in) :: self
+        integer,            intent(in) :: i
+        character(len=8) :: ev
+        integer :: ios
+        node_ntests = self%ntests
+        call get_environment_variable('SIMPLE_SPLIT_HIER', ev, status=ios)
+        if( ios /= 0 .or. ev /= 'yes' ) return
+        node_ntests = max(1, nint(real(nlines(string(self%root//'/node_r/rows.txt'))) / &
+            &real(max(1, nlines(string(self%ndir(i)//'/rows.txt'))))))
+    end function node_ntests
