+    ! SIMPLE_TREE_INHERIT=yes: a node without a pole splits at the median of its rows' leading parent stage-B evidence contrast
+    function parent_halves( nd, pd, nrows ) result( lab )
+        character(len=*), intent(in) :: nd, pd
+        integer,          intent(in) :: nrows
+        integer,  allocatable :: lab(:), nr(:), prows(:), ix(:), rows(:), at(:), inds(:)
+        real,     allocatable :: ev(:,:), cov(:,:), evec(:,:), w(:), y(:)
+        logical,  allocatable :: mem(:)
+        character(len=8192) :: line
+        integer :: fu, io, n, q, k, ip, s, r, m
+        real    :: tk
+        allocate(lab(0))
+        if( .not. file_exists(string(pd//'/stageB/prob_state_evidence.txt')) ) return
+        rows = read_ints(nd//'/rows.txt')
+        allocate(mem(nrows), source=.false.)
+        mem(rows) = .true.
+        ix = node_index(nrows, nd)
+        if( file_exists(string(pd//'/stageB/'//NR_ROWS)) ) nr = read_ints(pd//'/stageB/'//NR_ROWS)
+        if( local_rows(pd) ) prows = read_ints(pd//'/rows.txt')
+        call fopen(fu, string(pd//'/stageB/prob_state_evidence.txt'), status='old', action='read', iostat=io)
+        if( io /= 0 ) return
+        n = 0
+        q = 0
+        do
+            read(fu,'(A)',iostat=io) line
+            if( io /= 0 ) exit
+            if( line(1:1) == '#' .or. len_trim(line) == 0 ) cycle
+            n = n + 1
+            if( q == 0 ) q = nwords(line) - 3
+        end do
+        rewind(fu)
+        allocate(ev(size(rows),max(q,1)), source=0.)
+        allocate(at(size(rows)), source=0)
+        m = 0
+        k = 0
+        do while( k < n )
+            read(fu,'(A)') line
+            if( line(1:1) == '#' .or. len_trim(line) == 0 ) cycle
+            k = k + 1
+            read(line,*) ip, s, tk
+            r = ip
+            if( allocated(nr) ) r = nr(1 + ip)
+            if( allocated(prows) ) r = prows(r)
+            if( .not. mem(r) ) cycle
+            m = m + 1
+            at(m) = ix(r)
+            read(line,*) ip, s, tk, ev(m,1:q)
+            ev(m,1:q) = max(ev(m,1:q), maxval(ev(m,1:q)) - 30.)
+        end do
+        call fclose(fu)
+        if( q < 2 .or. m /= size(rows) ) return
+        do k = 1, q
+            ev(:,k) = ev(:,k) - sum(ev(:,k)) / real(m)
+        end do
+        cov = matmul(transpose(ev), ev) / real(max(m - 1, 1))
+        allocate(evec(q,1), w(1))
+        call eigh(q, cov, 1, w, evec)
+        y    = matmul(ev, evec(:,1))
+        inds = [(k, k=1,m)]
+        call hpsort(y, inds)
+        deallocate(lab)
+        allocate(lab(size(project_states(nd//'/'//NODE_PROJ))), source=0)
+        do k = 1, m
+            lab(at(inds(k))) = merge(1, 2, 2 * k <= m)
+        end do
+    end function parent_halves
+
     function two_groups_in( fd ) result( lab )
         character(len=*), intent(in) :: fd
         integer, allocatable :: lab(:), st(:), pres(:), grp(:)
