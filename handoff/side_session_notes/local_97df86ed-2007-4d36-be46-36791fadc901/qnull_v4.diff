+
+        ! test switch: pseudo-splits of the same particles by a per-particle quality score (the contrast field, then corr), group
+        ! sizes per half as the real split, assigned by the score's rank within each nuisance stratum; the real split stands only if
+        ! its re-test beats the largest pseudo-split's by the uncorrected split level, z = dT / (sqrt(2) x the re-test null's sd)
+        subroutine quality_null
+            integer, allocatable :: pa(:), pb(:), pl(:), gf(:), ea(:), eb(:)
+            character(len=:), allocatable :: line
+            real    :: tq, rr, sr, rq, sq, tqmax, zq, zuse, fc, sc, m2, s2
+            integer :: iq, kk
+            logical :: l_keep
+            if( size(nl%nul2) < 2 ) return
+            m2 = medianr(nl%nul2)
+            s2 = sqrt(sum((nl%nul2 - sum(nl%nul2) / real(size(nl%nul2)))**2) / real(size(nl%nul2) - 1))
+            fc = min(max(self%shell_corr(cons(:,:,:,1), cons(:,:,:,2), self%kt, self%khi), 1.e-6), 0.999999)
+            sc = fc / ((1. - fc) * 0.5 * real(size(ia) + size(ib)))
+            call rho_se(rst, la, lb, m2, s2, sc, rr, sr)
+            line  = 'QUALITY NULL: real re-test '//fmtr(real(rst,dp),4)//' rho '//fmtr(real(rr,dp),5)
+            tqmax = -huge(tqmax)
+            if( self%l_qcore .and. .not. allocated(self%cqc) ) call core_scores
+            do iq = 1, 3
+                if( iq == 1 .and. .not. allocated(self%cq) ) cycle
+                if( iq == 3 .and. .not. self%l_qcore ) cycle
+                pa = qsplit(ia, la, sta, iq)
+                pb = qsplit(ib, lb, stb, iq)
+                call self%decide(ia, ib, pa, pb, 2, eps, neq, cons, self%kt, -huge(tq), 'quality pseudo-split', pl, gf, ea, eb, kk, tq)
+                call rho_se(tq, pa, pb, m2, s2, sc, rq, sq)
+                line  = line//' | by '//trim(qname(iq))//': re-test '//fmtr(real(tq,dp),4)//' rho '//fmtr(real(rq,dp),5)
+                ! in core mode only the score blind to the focus region decides; contrast and corr are logged
+                if( .not. self%l_qcore .or. iq == 3 ) tqmax = max(tqmax, tq)
+            end do
+            if( tqmax == -huge(tqmax) ) return
+            zuse   = split_zcrit(1)
+            zq     = (rst - tqmax) / max(sqrt(2.) * s2, 1.e-12)
+            l_keep = zq >= zuse
+            write(logfhandle,'(A)') line//' | z (real - max pseudo re-test) '//fmtr(real(zq,dp),2)//' vs '//fmtr(real(zuse,dp),2)//&
+                &' (the uncorrected split level) -> '//merge('KEEP  ', 'REFUSE', l_keep)
+            if( .not. l_keep .and. kstar >= 2 )then
+                gof   = 1
+                kstar = 1
+            endif
+        end subroutine quality_null
