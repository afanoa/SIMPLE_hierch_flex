+        ! per-particle quality blind to the focus region: the particle's correlation with the other half's consensus (an unmasked
+        ! Wiener map in the junk band) masked to the sphere outside the focus mask, CTF-weighted, over the junk band
+        subroutine core_scores
+            type(ivec) :: hx(2)
+            complex,  allocatable :: mp(:,:,:,:)
+            real,     allocatable :: rot(:,:,:,:), core(:,:,:)
+            real(dp), allocatable :: epsv(:)
+            real(dp) :: a(self%kj,1), b(self%kj,1)
+            real, pointer :: rmat(:,:,:)
+            integer :: e, i
+            rot = self%sym_rots()
+            do e = 1, 2
+                hx(e)%v = pack([(i, i=1,self%n)], self%eo == e - 1)
+            end do
+            epsv = 0.5_dp * (self%band_density(rot, hx(1)%v) + self%band_density(rot, hx(2)%v))
+            allocate(mp(self%nh,self%box,self%box,2))
+            if( allocated(self%msph) )then
+                core = self%msph - self%msk3
+            else
+                core = self%msk3
+            endif
+            if( maxval(core) < 0.5 ) core = self%msk3
+            do e = 1, 2
+                call self%band_wiener(rot, hx(e)%v, epsv, mp(:,:,:,e))
+                call self%wimgs(1)%set_cmat(mp(:,:,:,e))
+                call self%wimgs(1)%ifft
+                call self%wimgs(1)%get_rmat_ptr(rmat)
+                rmat = rmat * core
+                call self%wimgs(1)%fft
+                mp(:,:,:,e) = self%wimgs(1)%get_cmat()
+            end do
+            allocate(self%cqc(self%n), source=0.)
+            !$omp parallel do default(shared) private(i,a,b) schedule(static) proc_bind(close)
+            do i = 1, self%n
+                call self%band_terms(rot, i, mp(:,:,:,2-self%eo(i):2-self%eo(i)), a, b)
+                self%cqc(i) = real(sum(a) / sqrt(max(sum(b) * real(sum(self%f2j(:,i)),dp), 1.e-30_dp)))
+            end do
+            !$omp end parallel do
+            write(logfhandle,'(A)') 'core quality score (sphere outside the focus mask, junk band): median '//&
+                &fmtr(real(medianr(self%cqc),dp),4)//', 5 / 95 % '//fmtr(real(quantr(self%cqc,0.05),dp),4)//' / '//&
+                &fmtr(real(quantr(self%cqc,0.95),dp),4)
+        end subroutine core_scores
+
+        ! relative effect of a two-group labelling from its re-test T (null median m, sd s; consensus SNR sc) and its se from s
+        subroutine rho_se( t, lab_a, lab_b, m, s, sc, rho, se )
+            real,    intent(in)  :: t, m, s, sc
+            integer, intent(in)  :: lab_a(:), lab_b(:)
+            real,    intent(out) :: rho, se
+            real    :: y, dy
+            integer :: nn
+            nn  = max(1, min(count(lab_a == 1), count(lab_a == 2), count(lab_b == 1), count(lab_b == 2)))
+            y   = min(max((t - m) / max(1. - m, 1.e-6), 0.), 0.999)
+            dy  = s / max(1. - m, 1.e-6)
+            rho = 2. * y / ((1. - y) * real(nn)) / sc
+            se  = 2. * dy / ((1. - y)**2 * real(nn)) / sc
+        end subroutine rho_se
+
+        ! group sizes per half as the real labels; group 1 = the highest-scoring particles by their score's rank within the stratum
+        function qsplit( idx, lab, st, iq ) result( out )
+            use simple_srch_sort_loc, only: hpsort
+            integer, intent(in)  :: idx(:), lab(:), st(:), iq
+            integer, allocatable :: out(:), ord(:), mem(:)
+            real,    allocatable :: sco(:), key(:), sub(:)
+            integer :: i, j, s0, n1
+            allocate(sco(size(idx)), key(size(idx)), out(size(idx)))
+            do i = 1, size(idx)
+                select case( iq )
+                    case( 1 )
+                        sco(i) = self%cq(idx(i))
+                    case( 2 )
+                        sco(i) = self%qv(idx(i))
+                    case default
+                        sco(i) = self%cqc(idx(i))
+                end select
+            end do
+            key = 0.5
+            do s0 = minval(st), maxval(st)
+                mem = pack([(i, i=1,size(st))], st == s0)
+                if( size(mem) < 2 ) cycle
+                sub = sco(mem)
+                ord = [(j, j=1,size(mem))]
+                call hpsort(sub, ord)
+                do j = 1, size(mem)
+                    key(mem(ord(j))) = (real(j) - 0.5) / real(size(mem))
+                end do
+            end do
+            ord = [(i, i=1,size(idx))]
+            call hpsort(key, ord)
+            n1  = count(lab == 1)
+            out = 2
+            do j = size(idx), max(1, size(idx) - n1 + 1), -1
+                out(ord(j)) = 1
+            end do
+        end function qsplit
 
